{
  "name": "icebreaker-dev-configs",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "Icebreaker's dev-configs monorepo for shared linting presets",
  "author": "ice breaker <1324318532@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/dev-configs.git"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/dev-configs/issues"
  },
  "keywords": [
    "dev-configs",
    "eslint",
    "stylelint",
    "commitlint",
    "icebreakers"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check:no-tracked-build-artifacts": "node ./scripts/check-no-tracked-build-artifacts.mjs",
    "check:workflows": "node ./scripts/check-workflows.mjs",
    "dev": "turbo run dev --parallel",
    "test": "node -e \"require('node:fs').mkdirSync('coverage/.tmp', { recursive: true })\" && pnpm check:no-tracked-build-artifacts && vitest run && pnpm test:types",
    "test:dev": "node -e \"require('node:fs').mkdirSync('coverage/.tmp', { recursive: true })\" && pnpm check:no-tracked-build-artifacts && vitest",
    "test:types": "turbo run test:types",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "publish-packages": "repo release stable publish",
    "release:pre": "repo release pre publish",
    "version-packages": "pnpm version -r",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "postinstall": "pnpm run build",
    "commit": "commit",
    "sync": "turbo run sync",
    "inspector": "npx @eslint/config-inspector",
    "build:inspector": "pnpm build && npx @eslint/config-inspector build",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor",
    "-------": "-----------",
    "release": "pnpm change",
    "pr:alpha": "repo release pre enter alpha",
    "pr:beta": "repo release pre enter beta",
    "pr:rc": "repo release pre enter rc",
    "pr:next": "repo release pre enter next",
    "pr:exit": "repo release pre exit",
    "--------": "----------------",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@eslint/config-inspector": "^3.3.0",
    "@eslint/eslintrc": "^3.3.6",
    "@icebreakers/commitlint-config": "workspace:*",
    "@icebreakers/eslint-config": "workspace:*",
    "@icebreakers/stylelint-config": "workspace:*",
    "@next/eslint-plugin-next": "^16.3.2",
    "@prettier/plugin-xml": "^3.4.2",
    "@tanstack/eslint-plugin-query": "^5.102.0",
    "@types/eslint-plugin-tailwindcss": "^3.17.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "@types/set-value": "^4.0.3",
    "@typescript-eslint/types": "^8.67.0",
    "@unocss/eslint-plugin": "66.8.1",
    "@vitest/coverage-v8": "~4.1.11",
    "astro-eslint-parser": "^3.1.0",
    "ci-info": "^4.4.0",
    "cross-env": "^10.1.0",
    "defu": "^6.1.7",
    "es-toolkit": "^1.51.0",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-mdx": "3.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.0",
    "get-value": "^4.1.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "micromatch": "^4.0.8",
    "only-allow": "^1.2.2",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "repoctl": "5.4.1",
    "rimraf": "^6.1.3",
    "set-value": "^4.1.0",
    "stylelint": "^17.14.1",
    "svelte": "^5.56.10",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.3.3",
    "tsd": "^0.33.0",
    "tsdown": "0.22.14",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "~4.1.11",
    "yaml": "^2.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
